[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://src/dialogs/golem.dialogue")
locale/locale_filter_mode=0

[physics]

2d/default_gravity=1000.0
2d/size/initial_position_type=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/size/viewport_width=1152
lights_and_shadows/size/viewport_height=648
lights_and_shadows/size/initial_position_type=0
