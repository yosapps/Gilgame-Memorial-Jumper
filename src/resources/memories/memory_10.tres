[resource]
script = ExtResource("1_data")
crystal_id = &"memory_10"
memory_index = 10
display_name = "時空の裂け目"
developer_description = "地面が裂け、落ちかけたガロードをギルガメが救う。代わりにギルガメが時空の歪みへ落ちていく、最も強く感情的な記憶。"
associated_dungeon_area = &"time_distortion"
memory_images = Array[Texture2D]([ExtResource("3_image"), ExtResource("4_image"), ExtResource("2_image")])
storybook_memory_images = Array[Texture2D]([ExtResource("story_1"), ExtResource("story_2"), ExtResource("story_3"), ExtResource("story_4"), ExtResource("story_5"), ExtResource("story_6")])
expected_image_paths = PackedStringArray("res://assets/memories/memory_10/memory_10_02.png", "res://assets/memories/memory_10/memory_10_03.png", "res://assets/memories/memory_10/memory_10_01.png")
short_subtitle = "ガロード……思い出した。"
seconds_per_image = 5.0
transition_duration = 1.5
