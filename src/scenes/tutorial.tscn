[node name="Npc" parent="." unique_id=264556763 instance=ExtResource("13_ha8qc")]
position = Vector2(504, 507)
dialogue = Array[String](["おや、挑戦者かい？ この塔は、焦る者ほど下へ落ちる場所だ。", "A・Dキーか左右キーで移動。スペースを長押しして、離すとジャンプするぞ。", "空中では向きを変えられない。跳ぶ前に、着地点をよく見るんだ。", "失敗しても大丈夫。落ちた分だけ、次の一跳びがうまくなる。頂上で会おう！"])

