[sub_resource type="Shader" id="BackgroundShader"]
code = "shader_type canvas_item;

float sparkle(vec2 p, float seed) {
	return pow(max(0.0, sin(p.x * 17.0 + seed) * sin(p.y * 13.0 - seed)), 18.0);
}

void fragment() {
	vec2 uv = UV;
	float radial = 1.0 - smoothstep(0.0, 0.78, distance(uv, vec2(0.5, 0.46)));
	float horizon = smoothstep(0.9, 0.1, uv.y);
	vec3 deep = vec3(0.012, 0.025, 0.075);
	vec3 blue = vec3(0.025, 0.12, 0.24);
	vec3 color = mix(deep, blue, radial * 0.72 + horizon * 0.08);
	float dust = sparkle(uv * 5.0, 1.7) + sparkle(uv.yx * 7.0, 4.2);
	color += vec3(0.12, 0.34, 0.58) * dust * (0.18 + 0.08 * sin(TIME));
	COLOR = vec4(color, 1.0);
}"

