[sub_resource type="Shader" id="BackgroundShader"]
code = "shader_type canvas_item;\n\nfloat sparkle(vec2 p, float seed) {\n\treturn pow(max(0.0, sin(p.x * 17.0 + seed) * sin(p.y * 13.0 - seed)), 18.0);\n}\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat radial = 1.0 - smoothstep(0.0, 0.78, distance(uv, vec2(0.5, 0.46)));\n\tfloat horizon = smoothstep(0.9, 0.1, uv.y);\n\tvec3 deep = vec3(0.012, 0.025, 0.075);\n\tvec3 blue = vec3(0.025, 0.12, 0.24);\n\tvec3 color = mix(deep, blue, radial * 0.72 + horizon * 0.08);\n\tfloat dust = sparkle(uv * 5.0, 1.7) + sparkle(uv.yx * 7.0, 4.2);\n\tcolor += vec3(0.12, 0.34, 0.58) * dust * (0.18 + 0.08 * sin(TIME));\n\tCOLOR = vec4(color, 1.0);\n}"

[sub_resource type="ShaderMaterial" id="BackgroundMaterial"]
